# Copy to `electron-builder.env` (gitignored) to sign and notarize a local release build.
# electron-builder's CLI reads that filename from the project root on every run, and never packs
# it into the app. A variable already set in the shell wins over the file.
#
# The signing certificate itself is not named here: electron-builder finds the single
# "Developer ID Application" identity in the login keychain. CSC_LINK and CSC_KEY_PASSWORD are
# for CI only, where there is no keychain to find it in.

# Apple ID of the Developer Program account, its team, and an app-specific password minted at
# account.apple.com. Notarization needs all three or it refuses to start.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# The release gates `pnpm dist` runs first, accepted as a comma separated list.
NEOTUNE_RELEASE_GATES_ACCEPTED=auth,range,pcm,lyrics-rights
