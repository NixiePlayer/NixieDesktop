{
	"name": "noctune",
	"version": "0.1.0",
	"description": "A local-first macOS client for YouTube Music, with gapless playback, offline downloads, and synced lyrics.",
	"author": "Edoardo Ranghieri",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NoctunePlayer/NoctuneDesktop.git"
	},
	"private": true,
	"type": "module",
	"main": "dist-electron/main/index.js",
	"packageManager": "pnpm@11.16.0",
	"engines": {
		"node": "24.15.0",
		"pnpm": "11.16.0"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"postinstall": "node scripts/dev-app-name.mjs",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"package": "pnpm build && electron-builder --mac --dir -c.mac.identity=-",
		"dist": "pnpm release:gate && pnpm build && electron-builder --mac -c.mac.notarize=true",
		"release:gate": "node --env-file-if-exists=electron-builder.env scripts/release-gates.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt --check",
		"fmt:fix": "oxfmt",
		"check": "pnpm fmt && pnpm lint && pnpm typecheck && pnpm test && pnpm generate-routes && pnpm build"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@tanstack/react-router": "1.170.18",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"lucide-react": "1.27.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"youtubei.js": "17.2.0"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.3",
		"@tanstack/router-cli": "1.167.21",
		"@tanstack/router-plugin": "1.168.23",
		"@types/node": "22.20.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"electron": "43.2.0",
		"electron-builder": "26.15.3",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"oxlint-tsgolint": "7.0.2001",
		"shadcn": "4.15.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.1.5",
		"vite-plugin-electron": "1.1.0",
		"vitest": "4.1.10"
	},
	"build": {
		"appId": "com.theedoran.noctunedesktop",
		"productName": "Noctune",
		"asar": true,
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**",
			"dist-electron/**",
			"package.json",
			"LICENSE",
			"PRIVACY.md",
			"SECURITY.md",
			"THIRD_PARTY_NOTICES.md"
		],
		"mac": {
			"category": "public.app-category.music",
			"icon": "build/icon.icns",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"notarize": false,
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"afterSign": "scripts/staple.mjs"
	}
}
